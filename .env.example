# --------------------------------------------------------------------------
# JEEM LABS — environment
# Copy to `.env.local`. Never commit real values.
# --------------------------------------------------------------------------

# Canonical public origin. Used for metadata, sitemap, canonical URLs, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://thejeemlabs.com

# Where inquiry + contact submissions are delivered.
# Server-side only. Never prefix with NEXT_PUBLIC_.
INQUIRY_NOTIFY_EMAIL=hello@thejeemlabs.com

# Optional transactional email provider key (e.g. Resend).
# When absent, submissions are validated and logged server-side only.
EMAIL_API_KEY=

# Optional scheduling link surfaced by "Prefer talking? Book a call".
# When absent, the UI falls back to email.
NEXT_PUBLIC_BOOKING_URL=
